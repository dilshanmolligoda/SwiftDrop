# =====================================================================
# SwiftDrop — environment variables
# ---------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the values marked  <change-me>
# 3. NEVER commit .env  (it is in .gitignore)
#
# docker-compose.yml reads this file. Each service only receives the
# variables it needs. In Kubernetes the same keys are split into a
# ConfigMap (non-secret) and a Secret (marked 🔒 below).
# =====================================================================

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Colombo

# ---------- Public URLs ----------
WEB_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ---------- API (NestJS) ----------
API_PORT=3000
API_PREFIX=api
API_VERSION=1

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=<change-me>                 # 🔒
# Used by Prisma. Keep in sync with the values above.
DATABASE_URL=postgresql://swiftdrop:<change-me>@postgres:5432/swiftdrop?schema=public   # 🔒

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=swiftdrop
RABBITMQ_DEFAULT_PASS=<change-me>             # 🔒
RABBITMQ_URL=amqp://swiftdrop:<change-me>@rabbitmq:5672   # 🔒
RABBITMQ_EVENTS_EXCHANGE=parcel.events
RABBITMQ_PREFETCH=10

# ---------- Transactional outbox publisher ----------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# ---------- Authentication (JWT) ----------
JWT_ACCESS_SECRET=<change-me-long-random>     # 🔒  openssl rand -base64 48
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=<change-me-long-random>    # 🔒
JWT_REFRESH_TTL=7d
PASSWORD_HASH_ROUNDS=12

# ---------- Google OAuth 2.0 (Login with Google) ----------
GOOGLE_CLIENT_ID=<change-me>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<change-me>              # 🔒
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---------- Merchant API keys ----------
API_KEY_PEPPER=<change-me-long-random>        # 🔒  mixed into API key hashes

# ---------- Merchant webhooks ----------
WEBHOOK_SECRET_ENCRYPTION_KEY=<change-me-32-bytes-base64>   # 🔒 encrypts per-merchant signing secrets at rest
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_BASE_MS=30000

# ---------- Notifications ----------
NOTIFY_EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=                                # 🔒
SMTP_FROM="SwiftDrop <no-reply@swiftdrop.local>"
SMS_PROVIDER=mock                             # mock = log + store in DB, no real SMS

# ---------- File uploads (proof of delivery) ----------
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=5

# ---------- Frontend (Vite — only VITE_* vars reach the browser) ----------
# ⚠️ Anything prefixed VITE_ is PUBLIC. Never put secrets here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_AI_ASSISTANT_URL=http://localhost:3100

# ---------- AI Delivery Assistant (bonus) ----------
AI_ASSISTANT_PORT=3100
AI_BACKEND_API_URL=http://api:3000/api/v1
LLM_PROVIDER=<change-me>                      # e.g. anthropic | openai | gemini
LLM_MODEL=<change-me>
LLM_API_KEY=<change-me>                       # 🔒

# ---------- Mock merchant store (demo webhook receiver) ----------
MOCK_MERCHANT_PORT=4000
