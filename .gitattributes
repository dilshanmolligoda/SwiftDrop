# Normalise line endings so Windows and macOS/Linux teammates don't fight over CRLF/LF
* text=auto eol=lf

# Shell scripts and Docker entrypoints must stay LF or containers fail to start
*.sh text eol=lf
Dockerfile text eol=lf

# Windows-only scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary

# Lockfiles: let git treat them as generated (cleaner diffs in PRs)
package-lock.json linguist-generated=true -diff
