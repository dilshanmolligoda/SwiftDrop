# Web app (Vite) — copy to .env:  cp .env.example .env
# ⚠️ Every VITE_* value is bundled into the JavaScript and visible in the browser.
#    Never put secrets here.
# In Docker these are passed as build args from the root .env instead.

VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_AI_ASSISTANT_URL=http://localhost:3100
