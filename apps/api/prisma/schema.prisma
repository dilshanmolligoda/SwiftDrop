// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT
  COURIER
  DISPATCHER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParcelStatus {
  CREATED
  ASSIGNED
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum DeliveryFailureReason {
  RECIPIENT_UNAVAILABLE
  INCORRECT_ADDRESS
  RECIPIENT_REJECTED
  UNABLE_TO_CONTACT
  OTHER
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
}

enum MerchantOrderStatus {
  AWAITING_PICKUP
  OUT_FOR_DELIVERY
  IN_TRANSIT
  PICKED_UP
  DELIVERY_FAILED
  DELIVERED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  fullName        String
  phoneNumber     String?
  passwordHash    String?
  role            Role           @default(CUSTOMER)
  approvalStatus  ApprovalStatus @default(PENDING)
  isActive        Boolean        @default(true)
  googleSubject   String?        @unique
  reviewedAt      DateTime?
  reviewedBy      String?        @db.Uuid
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  merchantProfile MerchantProfile?
  courierProfile  CourierProfile?
  merchantOrders  MerchantOrder[]
  parcels         Parcel[]

  courierAssignments DeliveryAssignment[] @relation("CourierAssignments")
  createdAssignments DeliveryAssignment[] @relation("AssignmentCreators")
  parcelStatusEvents ParcelStatusEvent[]  @relation("StatusEventActors")
  deliveryProofs     DeliveryProof[]      @relation("ProofCouriers")

  webhookEndpoint WebhookEndpoint?
  notifications   Notification[]

  @@map("users")
}

model DeliveryAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  parcelId     String   @db.Uuid
  courierId    String   @db.Uuid
  assignedById String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)
  endedAt      DateTime? @db.Timestamptz(3)

  parcel       Parcel              @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  courier      User                @relation("CourierAssignments", fields: [courierId], references: [id], onDelete: Restrict)
  assignedBy   User                @relation("AssignmentCreators", fields: [assignedById], references: [id], onDelete: Restrict)
  statusEvents ParcelStatusEvent[]
  proofs       DeliveryProof[]

  // Composite keys ensure dependent events and proofs belong to this assignment's parcel.
  @@unique([id, parcelId])
  @@unique([id, parcelId, courierId])
  @@index([courierId, assignedAt, endedAt])
  @@index([parcelId, assignedAt])
  @@index([parcelId, endedAt])
  @@map("delivery_assignments")
}

model ParcelStatusEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  parcelId      String                 @db.Uuid
  assignmentId  String?                @db.Uuid
  actorId       String?                @db.Uuid
  proofId       String?                @unique @db.Uuid
  status        ParcelStatus
  note          String?                @db.Text
  failureReason DeliveryFailureReason?
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)

  parcel     Parcel              @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  assignment DeliveryAssignment? @relation(fields: [assignmentId, parcelId], references: [id, parcelId], onDelete: Restrict)
  actor      User?               @relation("StatusEventActors", fields: [actorId], references: [id], onDelete: Restrict)
  proof      DeliveryProof?      @relation(fields: [proofId, parcelId], references: [id, parcelId], onDelete: Restrict)

  @@index([parcelId, createdAt])
  @@index([actorId, createdAt])
  @@unique([proofId, parcelId])
  @@map("parcel_status_events")
}

model DeliveryProof {
  id               String   @id @default(uuid()) @db.Uuid
  parcelId         String   @db.Uuid
  assignmentId     String   @db.Uuid
  courierId        String   @db.Uuid
  storageProvider  String   @default("local") @db.VarChar(32)
  storageKey       String   @unique @db.VarChar(512)
  originalFilename String   @db.VarChar(255)
  contentType      String   @db.VarChar(127)
  sizeBytes        Int
  checksumSha256   String?  @db.Char(64)
  uploadedAt       DateTime @default(now()) @db.Timestamptz(3)

  parcel         Parcel             @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  assignment     DeliveryAssignment @relation(fields: [assignmentId, parcelId, courierId], references: [id, parcelId, courierId], onDelete: Restrict)
  courier        User               @relation("ProofCouriers", fields: [courierId], references: [id], onDelete: Restrict)
  statusEvent    ParcelStatusEvent?
  deliveredParcel Parcel?            @relation("ParcelDeliveredProof")

  @@unique([id, parcelId])
  @@index([parcelId, uploadedAt])
  @@map("delivery_proofs")
}

model MerchantProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  businessName    String
  businessAddress String
  businessType    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("merchant_profiles")
}

model CourierProfile {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @unique @db.Uuid
  vehicleType   VehicleType
  licensePlate  String?
  licenseNumber String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("courier_profiles")
}

model MerchantOrder {
  id                     String              @id @default(uuid()) @db.Uuid
  merchantUserId         String              @db.Uuid
  reference              String
  trackingNumber         String              @unique
  recipientName          String
  destination             String
  source                 String              @default("PORTAL") @db.VarChar(16)
  status                 MerchantOrderStatus @default(AWAITING_PICKUP)
  failedDeliveryAttempts Int                 @default(0)
  deliveredAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  merchant User @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)
  /// Parcel created for this order (ADR 0003). Parcel.status is the source of truth.
  parcel   Parcel?

  @@unique([merchantUserId, reference])
  @@index([merchantUserId, updatedAt])
  @@index([merchantUserId, status])
  @@map("merchant_orders")
}

model Parcel {
  id                    String      @id @default(uuid()) @db.Uuid
  trackingNumber        String      @unique
  customerId            String      @db.Uuid
  senderName            String
  senderAddress         String
  recipientName         String
  recipientAddress      String
  recipientPhone        String
  deliveryInstructions  String?     @db.Text
  contentsDescription   String?     @db.VarChar(500)
  packageSize           PackageSize @default(MEDIUM)
  weightKg              Decimal     @db.Decimal(5, 2)
  weightGrams           Int?
  costLkr               Decimal     @db.Decimal(10, 2)
  status                ParcelStatus @default(PENDING)
  failureReason         String?
  failedDeliveryAttempts Int        @default(0)
  deliveredAt           DateTime?
  deliveredProofId      String?     @unique @db.Uuid
  /// Set when the parcel was booked through a merchant order (ADR 0003); null = customer parcel.
  merchantOrderId       String?     @unique @db.Uuid
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customer       User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignments    DeliveryAssignment[]
  statusEvents   ParcelStatusEvent[]
  proofs         DeliveryProof[]
  statusHistory  ParcelStatusHistory[]
  deliveredProof DeliveryProof?        @relation("ParcelDeliveredProof", fields: [deliveredProofId, id], references: [id, parcelId], onDelete: Restrict)
  merchantOrder  MerchantOrder?        @relation(fields: [merchantOrderId], references: [id], onDelete: SetNull)

  @@unique([deliveredProofId, id])
  @@index([status, updatedAt])
  @@index([customerId, status])
  @@index([trackingNumber])
  @@map("parcels")
}

model ParcelStatusHistory {
  id        String       @id @default(uuid()) @db.Uuid
  parcelId  String       @db.Uuid
  status    ParcelStatus
  location  String?
  note      String?
  createdAt DateTime     @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, createdAt])
  @@map("parcel_status_history")
}

// =====================================================================
// Events, webhooks and notifications (ARCHITECTURE.md §7)
// Event shapes: packages/contracts/src/events
// =====================================================================

/// Transactional outbox: written in the same transaction as the business
/// change, then published to RabbitMQ by the relay.
model OutboxEvent {
  /// Also the eventId inside the published message.
  id            String    @id @db.Uuid
  /// Monotonic insert order. Published as the event's `sequence`; per parcel it
  /// follows commit order because status changes on one parcel are serialized.
  sequence      BigInt    @unique @default(autoincrement())
  aggregateType String    @db.VarChar(32)
  aggregateId   String    @db.Uuid
  eventType     String    @db.VarChar(64)
  routingKey    String    @db.VarChar(128)
  /// Event body without `sequence`, which the relay adds from the column above.
  payload       Json
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)
  /// Failed publish attempts; the relay backs off using nextAttemptAt.
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  lastError     String?   @db.VarChar(1000)

  @@index([publishedAt, nextAttemptAt, sequence])
  @@index([aggregateId, sequence])
  @@map("outbox_events")
}

/// Idempotent consumers: one row per (event, consumer) already handled.
model ProcessedEvent {
  eventId     String   @db.Uuid
  consumer    String   @db.VarChar(64)
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("processed_events")
}

/// One webhook URL per merchant. The signing secret is AES-256-GCM encrypted
/// (merchant-integration/domain/webhook-secret.ts), never stored in plain text.
model WebhookEndpoint {
  id              String   @id @default(uuid()) @db.Uuid
  merchantUserId  String   @unique @db.Uuid
  url             String   @db.VarChar(2048)
  secretEncrypted String   @db.Text
  /// Last characters of the secret, so the dashboard can show which one is active.
  secretHint      String   @db.VarChar(16)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  merchant   User              @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  /// 2xx received.
  DELIVERED
  /// Timeout / network error / 408 / 429 / 5xx; another attempt is scheduled.
  RETRY_SCHEDULED
  /// Other 4xx; retrying would not help.
  FAILED
  /// Retryable failure on the last allowed attempt.
  DEAD_LETTERED
}

/// One row per delivery attempt, shown in the merchant dashboard.
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  endpointId     String                @db.Uuid
  eventId        String                @db.Uuid
  eventType      String                @db.VarChar(64)
  trackingNumber String
  /// 1-based; continues counting on a manual redelivery.
  attempt        Int
  status         WebhookDeliveryStatus
  /// URL at the time of the attempt (the endpoint URL may change later).
  requestUrl     String                @db.VarChar(2048)
  responseStatus Int?
  durationMs     Int?
  /// Short, sanitized reason (never the response body).
  errorMessage   String?               @db.VarChar(500)
  nextAttemptAt  DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId, attempt])
  @@index([endpointId, createdAt])
  @@index([eventId])
  @@map("webhook_deliveries")
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  SENT
  FAILED
  /// Not sent on purpose, e.g. no email address or channel disabled.
  SKIPPED
}

/// One row per (event, channel, recipient); the unique key stops duplicates.
model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  eventId         String              @db.Uuid
  channel         NotificationChannel
  recipientUserId String              @db.Uuid
  template        String              @db.VarChar(64)
  status          NotificationStatus
  errorMessage    String?             @db.VarChar(500)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  sentAt          DateTime?           @db.Timestamptz(3)

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, channel, recipientUserId])
  @@index([recipientUserId, createdAt])
  @@map("notifications")
}
