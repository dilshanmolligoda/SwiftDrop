// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT
  COURIER
  DISPATCHER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParcelStatus {
  CREATED
  ASSIGNED
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum DeliveryFailureReason {
  RECIPIENT_UNAVAILABLE
  INCORRECT_ADDRESS
  RECIPIENT_REJECTED
  UNABLE_TO_CONTACT
  OTHER
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
}

enum MerchantOrderStatus {
  AWAITING_PICKUP
  OUT_FOR_DELIVERY
  IN_TRANSIT
  PICKED_UP
  DELIVERY_FAILED
  DELIVERED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  fullName        String
  phoneNumber     String?
  passwordHash    String?
  role            Role           @default(CUSTOMER)
  approvalStatus  ApprovalStatus @default(PENDING)
  isActive        Boolean        @default(true)
  googleSubject   String?        @unique
  reviewedAt      DateTime?
  reviewedBy      String?        @db.Uuid
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  merchantProfile MerchantProfile?
  courierProfile  CourierProfile?
  merchantOrders  MerchantOrder[]
  parcels         Parcel[]

  courierAssignments DeliveryAssignment[] @relation("CourierAssignments")
  createdAssignments DeliveryAssignment[] @relation("AssignmentCreators")
  parcelStatusEvents ParcelStatusEvent[]  @relation("StatusEventActors")
  deliveryProofs     DeliveryProof[]      @relation("ProofCouriers")

  @@map("users")
}

model DeliveryAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  parcelId     String   @db.Uuid
  courierId    String   @db.Uuid
  assignedById String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)
  endedAt      DateTime? @db.Timestamptz(3)

  parcel       Parcel              @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  courier      User                @relation("CourierAssignments", fields: [courierId], references: [id], onDelete: Restrict)
  assignedBy   User                @relation("AssignmentCreators", fields: [assignedById], references: [id], onDelete: Restrict)
  statusEvents ParcelStatusEvent[]
  proofs       DeliveryProof[]

  // Composite keys ensure dependent events and proofs belong to this assignment's parcel.
  @@unique([id, parcelId])
  @@unique([id, parcelId, courierId])
  @@index([courierId, assignedAt, endedAt])
  @@index([parcelId, assignedAt])
  @@index([parcelId, endedAt])
  @@map("delivery_assignments")
}

model ParcelStatusEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  parcelId      String                 @db.Uuid
  assignmentId  String?                @db.Uuid
  actorId       String?                @db.Uuid
  proofId       String?                @unique @db.Uuid
  status        ParcelStatus
  note          String?                @db.Text
  failureReason DeliveryFailureReason?
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)

  parcel     Parcel              @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  assignment DeliveryAssignment? @relation(fields: [assignmentId, parcelId], references: [id, parcelId], onDelete: Restrict)
  actor      User?               @relation("StatusEventActors", fields: [actorId], references: [id], onDelete: Restrict)
  proof      DeliveryProof?      @relation(fields: [proofId, parcelId], references: [id, parcelId], onDelete: Restrict)

  @@index([parcelId, createdAt])
  @@index([actorId, createdAt])
  @@unique([proofId, parcelId])
  @@map("parcel_status_events")
}

model DeliveryProof {
  id               String   @id @default(uuid()) @db.Uuid
  parcelId         String   @db.Uuid
  assignmentId     String   @db.Uuid
  courierId        String   @db.Uuid
  storageProvider  String   @default("local") @db.VarChar(32)
  storageKey       String   @unique @db.VarChar(512)
  originalFilename String   @db.VarChar(255)
  contentType      String   @db.VarChar(127)
  sizeBytes        Int
  checksumSha256   String?  @db.Char(64)
  uploadedAt       DateTime @default(now()) @db.Timestamptz(3)

  parcel         Parcel             @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  assignment     DeliveryAssignment @relation(fields: [assignmentId, parcelId, courierId], references: [id, parcelId, courierId], onDelete: Restrict)
  courier        User               @relation("ProofCouriers", fields: [courierId], references: [id], onDelete: Restrict)
  statusEvent    ParcelStatusEvent?
  deliveredParcel Parcel?            @relation("ParcelDeliveredProof")

  @@unique([id, parcelId])
  @@index([parcelId, uploadedAt])
  @@map("delivery_proofs")
}

model MerchantProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  businessName    String
  businessAddress String
  businessType    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys         ApiKey[]
  webhookEndpoint WebhookEndpoint?

  @@map("merchant_profiles")
}

// Merchant API keys. Only a peppered hash of the key is stored; the full key
// is shown to the merchant once, when it is created.
model ApiKey {
  id                String          @id @default(uuid()) @db.Uuid
  merchantProfileId String          @db.Uuid
  name              String
  keyPrefix         String          @unique
  keyHash           String          @unique
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime        @default(now())

  merchantProfile   MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)

  @@index([merchantProfileId])
  @@map("api_keys")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// One webhook URL per merchant. The signing secret is encrypted at rest
// (AES-256-GCM, WEBHOOK_SECRET_ENCRYPTION_KEY) because it must be read back to
// sign each delivery.
model WebhookEndpoint {
  id                String            @id @default(uuid()) @db.Uuid
  merchantProfileId String            @unique @db.Uuid
  url               String
  encryptedSecret   String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  merchantProfile   MerchantProfile   @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)
  deliveries        WebhookDelivery[]

  @@map("webhook_endpoints")
}

// One event to deliver to a merchant, retried with backoff until it is
// delivered or given up on (FAILED).
model WebhookDelivery {
  id             String                   @id @default(uuid()) @db.Uuid
  endpointId     String                   @db.Uuid
  eventId        String                   @unique @db.Uuid
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus    @default(PENDING)
  attemptCount   Int                      @default(0)
  nextAttemptAt  DateTime?                @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  endpoint       WebhookEndpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts       WebhookDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// Every HTTP attempt, for the merchant's delivery log.
model WebhookDeliveryAttempt {
  id            String          @id @default(uuid()) @db.Uuid
  deliveryId    String          @db.Uuid
  attemptNumber Int
  statusCode    Int?
  error         String?
  durationMs    Int
  attemptedAt   DateTime        @default(now())

  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("webhook_delivery_attempts")
}

model CourierProfile {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @unique @db.Uuid
  vehicleType   VehicleType
  licensePlate  String?
  licenseNumber String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("courier_profiles")
}

model MerchantOrder {
  id                     String              @id @default(uuid()) @db.Uuid
  merchantUserId         String              @db.Uuid
  reference              String
  trackingNumber         String              @unique
  recipientName          String
  destination             String
  source                 String              @default("PORTAL") @db.VarChar(16)
  status                 MerchantOrderStatus @default(AWAITING_PICKUP)
  failedDeliveryAttempts Int                 @default(0)
  deliveredAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  merchant User @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)

  @@unique([merchantUserId, reference])
  @@index([merchantUserId, updatedAt])
  @@index([merchantUserId, status])
  @@map("merchant_orders")
}

model Parcel {
  id                    String      @id @default(uuid()) @db.Uuid
  trackingNumber        String      @unique
  customerId            String      @db.Uuid
  senderName            String
  senderAddress         String
  recipientName         String
  recipientAddress      String
  recipientPhone        String
  deliveryInstructions  String?     @db.Text
  contentsDescription   String?     @db.VarChar(500)
  packageSize           PackageSize @default(MEDIUM)
  weightKg              Decimal     @db.Decimal(5, 2)
  weightGrams           Int?
  costLkr               Decimal     @db.Decimal(10, 2)
  status                ParcelStatus @default(PENDING)
  failureReason         String?
  failedDeliveryAttempts Int        @default(0)
  deliveredAt           DateTime?
  deliveredProofId      String?     @unique @db.Uuid
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customer       User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignments    DeliveryAssignment[]
  statusEvents   ParcelStatusEvent[]
  proofs         DeliveryProof[]
  statusHistory  ParcelStatusHistory[]
  deliveredProof DeliveryProof?        @relation("ParcelDeliveredProof", fields: [deliveredProofId, id], references: [id, parcelId], onDelete: Restrict)

  @@unique([deliveredProofId, id])
  @@index([status, updatedAt])
  @@index([customerId, status])
  @@index([trackingNumber])
  @@map("parcels")
}

model ParcelStatusHistory {
  id        String       @id @default(uuid()) @db.Uuid
  parcelId  String       @db.Uuid
  status    ParcelStatus
  location  String?
  note      String?
  createdAt DateTime     @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, createdAt])
  @@map("parcel_status_history")
}
