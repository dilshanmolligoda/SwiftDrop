// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT
  COURIER
  DISPATCHER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  fullName        String         
  phoneNumber     String?
  passwordHash    String?
  role            Role            @default(CUSTOMER)
  approvalStatus  ApprovalStatus  @default(PENDING)
  isActive        Boolean         @default(true)
  googleSubject   String?         @unique
  reviewedAt      DateTime?
  reviewedBy      String?         @db.Uuid
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  merchantProfile MerchantProfile?
  courierProfile  CourierProfile?

  @@map("users")
}

model MerchantProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  businessName    String
  businessAddress String
  businessType    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys         ApiKey[]

  @@map("merchant_profiles")
}

// Merchant API keys. Only a peppered hash of the key is stored; the full key
// is shown to the merchant once, when it is created.
model ApiKey {
  id                String          @id @default(uuid()) @db.Uuid
  merchantProfileId String          @db.Uuid
  name              String
  keyPrefix         String          @unique
  keyHash           String          @unique
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime        @default(now())

  merchantProfile   MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)

  @@index([merchantProfileId])
  @@map("api_keys")
}

model CourierProfile {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @unique @db.Uuid
  vehicleType   VehicleType
  licensePlate  String?
  licenseNumber String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("courier_profiles")
}
