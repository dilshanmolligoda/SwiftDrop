# Local overrides for running the API on your machine (npm run start:dev).
# Everything else is read from the repo-root .env. Values here win over
# the root file; real environment variables (e.g. Docker env_file) win over both.
#   cp .env.example .env

# Postgres runs in Docker but is reached from the host via localhost
DATABASE_URL=postgresql://swiftdrop:<change-me>@localhost:5432/swiftdrop?schema=public
