{$SITE_ADDRESS} {
	encode gzip
	# AI assistant. Must come before /api/*. Same origin as the app, so the
	# HttpOnly session cookie (path /api) reaches it automatically.
	handle /api/assistant/* {
		reverse_proxy ai-assistant:3100
	}
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:80
	}
}

{$SITE_ADDRESS}:8443 {
	basic_auth {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
	reverse_proxy mock-merchant:5000
}

{$SITE_ADDRESS}:8025 {
	basic_auth {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
	reverse_proxy mailpit:8025
}
